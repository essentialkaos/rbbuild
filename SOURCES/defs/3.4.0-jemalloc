CONFOPTS(openssl-3.0.17): {os_name}-{os_arch} --libdir=lib --openssldir={prefix}/openssl/ssl zlib-dynamic no-ssl3 no-tests shared -fPIC
PREFIX(openssl-3.0.17): {prefix}/openssl

CONFOPTS(ruby-3.4.0): --with-jemalloc --with-openssl-dir={prefix}/openssl --disable-install-doc

